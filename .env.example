# ===================================================================
# GESTION SCOLAIRE BACKEND - VARIABLES D'ENVIRONNEMENT (EXEMPLE)
# ===================================================================
# Copiez ce fichier vers .env et adaptez les valeurs pour votre environnement local.
# NE JAMAIS COMMITTER LE FICHIER .env CONTENANT DE VRAIS SECRETS.

# --- Base de Données PostgreSQL ---
DATABASE_URL=jdbc:postgresql://localhost:5432/gestion_scolaire_db
DB_USERNAME=postgres
DB_PASSWORD=votre_mot_de_passe_postgres_local

# --- Clé Secrète JWT ---
# OBLIGATOIRE. Minimum 32 caractères. Générer : openssl rand -base64 48
# Ne jamais réutiliser cette valeur d'exemple en production.
JWT_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_32_CARACTERES_MINIMUM

# --- Service d'envoi d'emails Brevo (SMTP) ---
# Laisser vide en dev désactive l'envoi (les OTP / liens de reset ne partiront pas).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=votre_compte_brevo@domaine.com
SMTP_PASSWORD=votre_cle_api_smtp_brevo

# --- Application ---
PORT=8089
FRONTEND_URL=http://localhost:3000

# Origines autorisées pour le CORS (séparées par des virgules, sans espace superflu).
# En production : lister uniquement les domaines réels des frontends.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://gestion-scolaire-admin.vercel.app

# --- JPA / Hibernate (optionnel) ---
# JPA_SHOW_SQL : journaliser les requêtes SQL (true en debug local uniquement). Défaut : false.
# JPA_DDL_AUTO : stratégie de schéma Hibernate. Défaut : update.
#               Passera à "validate" quand les migrations Flyway seront en place (Phase 1).
JPA_SHOW_SQL=false
JPA_DDL_AUTO=update
