# ===================================================================
# GESTION SCOLAIRE BACKEND - VARIABLES D'ENVIRONNEMENT (EXEMPLE)
# ===================================================================
# Copiez ce fichier vers .env et adaptez les valeurs pour votre environnement local.
# NE JAMAIS COMMITTER LE FICHIER .env CONTENANT DE VRAIS MOTS DE PASSE SUR GITHUB.

# Base de Données PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/gestion_scolaire_db
DB_USERNAME=postgres
DB_PASSWORD=votre_mot_de_passe_postgres_local

# Clé Secrète JWT (Minimum 32 caractères pour la sécurité)
JWT_SECRET=gestion-scolaire-jwt-secret-key-2026-changez-en-production

# Service d'envoi d'emails Brevo (SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=votre_compte_brevo@domaine.com
SMTP_PASSWORD=votre_cle_api_smtp_brevo

# Port de l'application & URL Frontend Next.js
PORT=8089
FRONTEND_URL=http://localhost:3000
